# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# Phase 2 — Supabase (Project Settings → API)
# ทั้งสองค่าเป็นค่าสาธารณะที่ใช้ฝั่งเบราว์เซอร์ได้ สิทธิ์ข้อมูลคุมด้วย Row Level Security
# Project URL ใช้แค่โดเมน ไม่ต้องมี /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# เปิดฟอร์มอีเมล/รหัสผ่านสำหรับทดสอบบนเครื่อง dev เท่านั้น (ห้ามตั้งเป็น true บน production)
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false

# Phase 3 — Omise (Opn Payments) · Public key (pkey_test_...) ใช้ฝั่งเบราว์เซอร์สร้าง token บัตร
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxx
# Secret key ของ Omise (skey_...) ห้ามใส่ที่นี่ — ตั้งใน Supabase Edge Function secrets
# ดู docs/setup-payments.md
